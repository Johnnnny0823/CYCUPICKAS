{
  "manifest_version": 3,
  "name": "AI 幫你監",
  "version": "1.1.2",
  "description": "中原選課系統課綱摘要輔助插件",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*/fake_selection_system.html",
        "http://127.0.0.1/*/fake_selection_system.html"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/course_summaries.json",
        "data/course_summaries_itouch.json"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
